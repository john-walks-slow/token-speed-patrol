{
  "_comment": "base_url 支持 \"$ENV_NAME\" / \"${ENV_NAME}\" 引用环境变量（配合 Secret PATROL_EXTRA_ENV 注入多行 KEY=VALUE）：私有端点不落盘，公开结果 JSONL 中以 \"(private)\" 占位。API key 永远只写环境变量名（api_key_env），明文经 Secret 注入。",
  "prompt": "Hello, tell me a short story in 3 sentences.",
  "max_tokens": 256,
  "temperature": null,
  "stream": true,
  "concurrency": 1,
  "iterations": 1,
  "max_rpm": 20,
  "timeout": 300,
  "targets": [
    {
      "provider_name": "Groq",
      "base_url": "https://api.groq.com/openai/v1",
      "api_key_env": "GROQ_API_KEY",
      "protocol": "openai",
      "models": [
        "openai/gpt-oss-20b",
        "openai/gpt-oss-120b",
        "openai/gpt-oss-safeguard-20b",
        "qwen/qwen3.8-27b",
        "allam-2-7b",
        "groq/compound",
        "groq/compound-mini"
      ]
    },
    {
      "provider_name": "NVIDIA NIM",
      "base_url": "https://integrate.api.nvidia.com/v1",
      "api_key_env": "NVIDIA_API_KEY",
      "protocol": "openai",
      "discover": true,
      "models": [
        "openai/gpt-oss-20b",
        "nvidia/nemotron-3.5-lightning-30b-a3b"
      ],
      "blacklist": [
        ".*(embed|retriever|clip|parse|reward|guard|safety).*",
        "nvidia/ai-synthetic-video-detector",
        "meta/llama-3.2-11b-vision-instruct"
      ]
    },
    {
      "provider_name": "Google Gemini",
      "base_url": "https://generativelanguage.googleapis.com/v1beta/openai/",
      "api_key_env": "GEMINI_API_KEY",
      "protocol": "openai",
      "models": [
        "gemini-3.8-flash",
        "gemini-3.7-flash",
        "gemini-3.6-flash",
        "gemini-3.5-flash",
        "gemini-3.5-flash-lite",
        "gemini-3.1-flash-lite",
        "gemini-flash-latest",
        "gemini-flash-lite-latest",
        "gemini-3.1-pro-preview",
        "gemini-pro-latest",
        "gemma-4-31b-it",
        "gemma-4-26b-a4b-it"
      ]
    },
    {
      "provider_name": "OpenRouter",
      "base_url": "https://openrouter.ai/api/v1",
      "api_key_env": "OPENROUTER_API_KEY",
      "protocol": "openai",
      "discover": true,
      "models": [],
      "whitelist": [".*:free"],
      "blacklist": [
        ".*inkling.*",
        "nvidia/nemotron-3.5-content-safety:free"
      ]
    }
  ]
}
